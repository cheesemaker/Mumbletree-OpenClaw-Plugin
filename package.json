{
  "name": "mumbletree-chat",
  "version": "1.0.0",
  "description": "Native Mumbletree Chat channel plugin for OpenClaw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheesemaker/Mumbletree-OpenClaw-Plugin.git"
  },
  "bugs": {
    "url": "https://github.com/cheesemaker/Mumbletree-OpenClaw-Plugin/issues"
  },
  "homepage": "https://github.com/cheesemaker/Mumbletree-OpenClaw-Plugin#readme",
  "keywords": ["openclaw", "mumbletree", "chat", "channel-plugin", "bot"],
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "src",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check src/*.js",
    "verify": "npm run check && npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "channel": {
      "id": "mumbletree-chat",
      "label": "Mumbletree Chat",
      "selectionLabel": "Mumbletree Chat",
      "detailLabel": "Mumbletree Chat Bot",
      "docsPath": "/channels/mumbletree-chat",
      "blurb": "Connect an OpenClaw agent to Mumbletree Chat channels.",
      "markdownCapable": true
    }
  },
  "devDependencies": {
    "ws": "^8.21.3"
  }
}
